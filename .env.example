# Peerdrive 本地部署环境配置样例
# 复制为 .env 并按需修改：cp .env.example .env

# 服务监听地址与端口
PEERDRIVE_HOST=127.0.0.1
PEERDRIVE_PORT=3000

# 存储目录与下载目录
PEERDRIVE_STORAGE=./storage
PEERDRIVE_DOWNLOAD_DIR=./downloads

# 文件共享配置（开启对外共享，声明共享目录）
PEERDRIVE_SHARE_ENABLE=true
PEERDRIVE_SHARE_DIRS=./storage,./downloads,./shared
PEERDRIVE_SHARE_COLLECTIONS=all

# 本机免密管理访问（绑定回环地址时安全）
PEERDRIVE_ALLOW_NO_AUTH=1

# PeerJS 信令互联与节点发现（默认连接 peersignal.moonchan.xyz，可供 Web 客户端与节点市场发现）
PEERDRIVE_PEERJS_ENABLE=true
PEERDRIVE_PEERJS_HOST=peersignal.moonchan.xyz
PEERDRIVE_PEERJS_PORT=443
PEERDRIVE_PEERJS_KEY=pd-signal-1edf5e05e4a52b7351392574
PEERDRIVE_PEERJS_SECURE=true
PEERDRIVE_PEERJS_ID=peerdrive-node-luminov
PEERDRIVE_DISCOVER_URL=https://peersignal.moonchan.xyz
PEERDRIVE_DISCOVER_PRESENCE=true

# 外部协议开关（单机模式可关闭）
PEERDRIVE_BT_DHT_ENABLE=false
PEERDRIVE_IPFS_GATEWAY_ENABLE=false

# 注册服务 JWT 密钥（生产环境请更换为强随机字符串）
PEERDRIVE_JWT_SECRET=peerdrive-local-jwt-secret-replace-in-production
