# Peerdrive 后端配置样例（占位值，不要填真实密钥；真实配置走环境变量或部署环境的 .env）
#
# 复制成本文件同级/任意位置的 .env 后按需修改；本项目不做自动加载，
# 用法示例：  set -a && . ./.env && set +a && go run -tags nosqlite ./cmd/server
#
# 完整清单见 doc/README.md「环境变量」，本次新增项见 doc/FULLSTACK-AUDIT.md §4。

# ── 服务 ──
PORT=3000
# 监听地址：空 = 所有网卡。管理面没有账号体系，"谁能连到这个端口"就是它的
# 全部边界 —— 只在本机用管理台的话设 127.0.0.1
PEERDRIVE_HOST=
# SQLite 元数据库路径（别放在会被清理的临时目录里）
PEERDRIVE_DB_PATH=./peerdrive.db
# 日志级别：DEBUG / INFO / WARN / ERROR
PEERDRIVE_LOG_LEVEL=INFO

# ── 存储与落盘 ──
# 这三个目录不能配成卷根（`/`、`C:\`），启动期会直接拒绝
PEERDRIVE_STORAGE=./storage
PEERDRIVE_DOWNLOAD_DIR=./downloads
# 对外共享的目录（逗号分隔）；未声明的目录一律拒绝
PEERDRIVE_SHARE_DIRS=

# ── 上传上限 ──
PEERDRIVE_MAX_UPLOAD_BYTES=104857600
PEERDRIVE_MAX_UPLOAD_ANON_BYTES=10485760

# ── 对外共享范围（默认关：开启即等于公开内容清单）──
PEERDRIVE_SHARE_ENABLE=false
# public / unlisted / private 三档里的好友名单（peer id 逗号分隔）
PEERDRIVE_SHARE_FRIENDS=

# ── 准入 ──
# 节点访问预共享密钥，空 = 开放模式。设了之后对端必须出示同样的密钥
PEERDRIVE_PSK=

# ── 认证（可选：不配则 AuthRequired 放行，单机模式）──
# 配了之后每次请求会带 Bearer 去注册服务器校验（结果缓存 30s）
PEERDRIVE_REG_SERVER=
PEERDRIVE_AUTH_TOKEN=

# ── 信令与发现 ──
# 默认就是项目公共信令，一般不用改；改了要保证节点与面板一致
PEERDRIVE_PEERJS_ENABLE=true
PEERDRIVE_PEERJS_HOST=peersignal.moonchan.xyz
PEERDRIVE_PEERJS_PORT=443
PEERDRIVE_PEERJS_SECURE=true
PEERDRIVE_DISCOVER_PRESENCE=true

# ── HTTP 加固（2026-09-23 新增）──
# 每 IP 速率上限，0 = 不限
PEERDRIVE_RATE_LIMIT_RPS=30
# 反代后面才需要填（填反跳地址）；空 = 只认 RemoteAddr，防伪造 X-Forwarded-For
PEERDRIVE_TRUSTED_PROXIES=
# 允许跨域的来源，逗号分隔（生产务必显式列全，别用 *）
# ⚠️ 代码里的默认值含 https://*.pages.dev —— 那个子域任何人都能免费注册，
#    公网部署必须在这里显式列出自己的来源
PEERDRIVE_ALLOWED_ORIGINS=http://localhost:5173
# 设为 off 可关闭 CSP（第三方页面嵌入兼容性兜底）
# PEERDRIVE_CSP=off
# 设为 off 关闭 /swagger/*（公网部署建议关，否则等于公开 105 个端点清单）
# PEERDRIVE_SWAGGER=off
